@@ -3,8 +3,67 @@
 import { serialize } from './producer.mjs';
 import { deserialize } from './consumer.mjs';
 test('empty documents round trip', () => {
+  assert.deepEqual(JSON.parse(serialize([])), { version: 2, entries: [] });
   assert.deepEqual(deserialize(serialize([])), []);
 });
+test('exports v2 entries in order, retaining archived and defaulting omitted values', () => {
+  const rows = [
+    { id: 'second', title: 'Archived document', archived: true },
+    { id: 'first', title: 'Active document', archived: false },
+    { id: 'third', title: 'Default document' },
+  ];
+  const text = serialize(rows);
+  assert.equal(typeof text, 'string');
+  assert.deepEqual(JSON.parse(text), {
+    version: 2,
+    entries: [
+      { id: 'second', title: 'Archived document', archived: true },
+      { id: 'first', title: 'Active document', archived: false },
+      { id: 'third', title: 'Default document', archived: false },
+    ],
+  });
+});
+test('imports legacy v1 items in order with archived set to false', () => {
+  assert.deepEqual(deserialize(JSON.stringify({
+    version: 1,
+    items: [
+      { id: 'second', title: 'Legacy document' },
+      { id: 'first', title: 'Another legacy document', archived: true },
+    ],
+  })), [
+    { id: 'second', title: 'Legacy document', archived: false },
+    { id: 'first', title: 'Another legacy document', archived: false },
+  ]);
+  assert.deepEqual(deserialize('{"version":1,"items":[]}'), []);
+});
+test('imports v2 entries with archived values intact', () => {
+  const rows = [
+    { id: 'second', title: 'Archived document', archived: true },
+    { id: 'first', title: 'Active document', archived: false },
+  ];
+  assert.deepEqual(deserialize(JSON.stringify({ version: 2, entries: rows })), rows);
+});
+test('documents round trip through v2 with normalized archived values', () => {
+  const rows = [
+    { id: 'second', title: 'Archived document', archived: true },
+    { id: 'first', title: 'Active document', archived: false },
+    { id: 'third', title: 'Default document' },
+  ];
+  assert.deepEqual(deserialize(serialize(rows)), [
+    { id: 'second', title: 'Archived document', archived: true },
+    { id: 'first', title: 'Active document', archived: false },
+    { id: 'third', title: 'Default document', archived: false },
+  ]);
+});
+test('legacy imports can be re-exported as v2', () => {
+  const legacy = '{"version":1,"items":[{"id":"legacy","title":"Legacy document"}]}';
+  assert.deepEqual(JSON.parse(serialize(deserialize(legacy))), {
+    version: 2,
+    entries: [{ id: 'legacy', title: 'Legacy document', archived: false }],
+  });
+});
 test('unsupported versions fail', () => {
-  assert.throws(() => deserialize('{"version":99,"items":[]}'), TypeError);
+  for (const version of [0, 3, 99, '2', null, undefined]) {
+    assert.throws(() => deserialize(JSON.stringify({ version, items: [], entries: [] })), TypeError);
+  }
 });
