 test('unsupported versions fail', () => {
   assert.throws(() => deserialize('{"version":99,"items":[]}'), TypeError);
 });
+test('exports the exact v2 wire format in input order with archive defaults', () => {
+  const text = serialize([
+    { id: 'third', title: 'Archived', archived: true },
+    { id: 'first', title: 'Active', archived: false },
+    { id: 'second', title: 'Default' },
+  ]);
+  assert.equal(typeof text, 'string');
+  assert.deepEqual(JSON.parse(text), {
+    version: 2,
+    entries: [
+      { id: 'third', title: 'Archived', archived: true },
+      { id: 'first', title: 'Active', archived: false },
+      { id: 'second', title: 'Default', archived: false },
+    ],
+  });
+});
+test('imports literal legacy items with archived false in input order', () => {
+  assert.deepEqual(
+    deserialize('{"version":1,"items":[{"id":"b","title":"Legacy B"},{"id":"a","title":"Legacy A","archived":true}]}'),
+    [
+      { id: 'b', title: 'Legacy B', archived: false },
+      { id: 'a', title: 'Legacy A', archived: false },
+    ],
+  );
+});
+test('imports literal v2 entries preserving archive state and input order', () => {
+  assert.deepEqual(
+    deserialize('{"version":2,"entries":[{"id":"b","title":"Archived","archived":true},{"id":"a","title":"Active","archived":false}]}'),
+    [
+      { id: 'b', title: 'Archived', archived: true },
+      { id: 'a', title: 'Active', archived: false },
+    ],
+  );
+});
+test('nonempty documents round trip with explicit and default archive states', () => {
+  assert.deepEqual(
+    deserialize(serialize([
+      { id: 3, title: 'Archived', archived: true },
+      { id: 1, title: 'Active', archived: false },
+      { id: 2, title: 'Default' },
+    ])),
+    [
+      { id: 3, title: 'Archived', archived: true },
+      { id: 1, title: 'Active', archived: false },
+      { id: 2, title: 'Default', archived: false },
+    ],
+  );
+});
+test('preserves Unicode titles exactly through both public entrypoints', () => {
+  const title = 'Café / Cafe\u0301 / 日本語 / 🗂️';
+  const packet = JSON.parse(serialize([{ id: 1, title }]));
+  assert.equal(packet.entries[0].title, title);
+  assert.equal(deserialize('{"version":1,"items":[{"id":1,"title":"Café / Cafe\\u0301 / 日本語 / 🗂️"}]}')[0].title, title);
+  assert.equal(deserialize('{"version":2,"entries":[{"id":1,"title":"Café / Cafe\\u0301 / 日本語 / 🗂️","archived":true}]}')[0].title, title);
+});
+test('serialization does not mutate caller rows or add archive defaults to them', () => {
+  const rows = [
+    { id: 1, title: 'Archived', archived: true },
+    { id: 2, title: 'Active', archived: false },
+    { id: 3, title: 'Default' },
+  ];
+  const before = structuredClone(rows);
+  rows.forEach(Object.freeze);
+  Object.freeze(rows);
+  serialize(rows);
+  assert.deepEqual(rows, before);
+});
