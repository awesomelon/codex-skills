 import assert from 'node:assert/strict';
 import { serialize } from './producer.mjs';
 import { deserialize } from './consumer.mjs';
+
+test('exports every row in order using the v2 wire format', () => {
+  const rows = [
+    { id: 'b', title: 'Archived', archived: true, extra: 'omitted' },
+    { id: 'a', title: 'Active', archived: false },
+    { id: 'c', title: 'Default' },
+  ];
+  const original = structuredClone(rows);
+  const text = serialize(rows);
+
+  assert.equal(typeof text, 'string');
+  assert.deepEqual(JSON.parse(text), {
+    version: 2,
+    entries: [
+      { id: 'b', title: 'Archived', archived: true },
+      { id: 'a', title: 'Active', archived: false },
+      { id: 'c', title: 'Default', archived: false },
+    ],
+  });
+  assert.deepEqual(rows, original);
+});
+
+test('imports legacy v1 rows with archived set to false', () => {
+  assert.deepEqual(deserialize(JSON.stringify({
+    version: 1,
+    items: [
+      { id: 'b', title: 'First' },
+      { id: 'a', title: 'Second', archived: true, extra: 'omitted' },
+    ],
+  })), [
+    { id: 'b', title: 'First', archived: false },
+    { id: 'a', title: 'Second', archived: false },
+  ]);
+});
+
+test('imports v2 rows in order, retaining archived and defaulting omitted values', () => {
+  assert.deepEqual(deserialize(JSON.stringify({
+    version: 2,
+    entries: [
+      { id: 'b', title: 'Archived', archived: true, extra: 'omitted' },
+      { id: 'a', title: 'Active', archived: false },
+      { id: 'c', title: 'Default' },
+    ],
+  })), [
+    { id: 'b', title: 'Archived', archived: true },
+    { id: 'a', title: 'Active', archived: false },
+    { id: 'c', title: 'Default', archived: false },
+  ]);
+});
+
+test('nonempty documents round trip through producer and consumer', () => {
+  const rows = [
+    { id: 'b', title: 'Archived', archived: true },
+    { id: 'a', title: 'Active', archived: false },
+    { id: 'c', title: 'Default' },
+  ];
+  assert.deepEqual(deserialize(serialize(rows)), [
+    rows[0],
+    rows[1],
+    { ...rows[2], archived: false },
+  ]);
+});
+
 test('empty documents round trip', () => {
+  assert.deepEqual(JSON.parse(serialize([])), { version: 2, entries: [] });
   assert.deepEqual(deserialize(serialize([])), []);
+  assert.deepEqual(deserialize('{"version":1,"items":[]}'), []);
 });
+
 test('unsupported versions fail', () => {
-  assert.throws(() => deserialize('{"version":99,"items":[]}'), TypeError);
