--- a/exchange.test.mjs
+++ b/exchange.test.mjs
@@ -10,0 +11,56 @@
+
+const rows = [
+  { id: 'β', title: 'Café ☕', archived: true },
+  { id: 'a', title: '日本語', archived: false },
+  { id: '末', title: 'Last row' },
+];
+const normalizedRows = rows.map(row => ({ ...row, archived: row.archived ?? false }));
+
+test('export emits the exact v2 contract without changing caller data', () => {
+  const input = rows.map(row => Object.freeze({ ...row }));
+  Object.freeze(input);
+  const before = structuredClone(input);
+  const packet = JSON.parse(serialize(input));
+  assert.deepEqual(packet, { version: 2, entries: normalizedRows });
+  assert.deepEqual(input, before);
+});
+
+test('v2 import preserves order, Unicode and archived values', () => {
+  assert.deepEqual(
+    deserialize(JSON.stringify({ version: 2, entries: rows })),
+    normalizedRows,
+  );
+});
+
+test('legacy v1 imports retain order and content with archived defaulting to false', () => {
+  const legacyRows = rows.map(({ id, title }) => ({ id, title }));
+  assert.deepEqual(
+    deserialize(JSON.stringify({ version: 1, items: legacyRows })),
+    legacyRows.map(row => ({ ...row, archived: false })),
+  );
+  assert.deepEqual(deserialize('{"version":1,"items":[]}'), []);
+});
+
+test('assembled v2 round trip preserves populated documents', () => {
+  assert.deepEqual(deserialize(serialize(rows)), normalizedRows);
+});
+
+test('legacy import can be re-exported and re-imported as v2', () => {
+  const legacyRows = rows.map(({ id, title }) => ({ id, title }));
+  const imported = deserialize(JSON.stringify({ version: 1, items: legacyRows }));
+  const exported = serialize(imported);
+  assert.deepEqual(JSON.parse(exported), {
+    version: 2,
+    entries: legacyRows.map(row => ({ ...row, archived: false })),
+  });
+  assert.deepEqual(deserialize(exported), imported);
+});
+
+test('unsupported and missing versions consistently raise TypeError', () => {
+  for (const version of [0, 3, '1', '2', null, undefined]) {
+    assert.throws(
+      () => deserialize(JSON.stringify({ version, items: [], entries: [] })),
+      TypeError,
+    );
+  }
+});
