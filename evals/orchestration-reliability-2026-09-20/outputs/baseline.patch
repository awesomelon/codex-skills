+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { CURRENT_VERSION, COLLECTION_FIELD, ARCHIVED_FIELD } from './contract.mjs';
+import { serialize } from './producer.mjs';
+
+test('shared contract identifies the v2 wire format', () => {
+  assert.equal(CURRENT_VERSION, 2);
+  assert.equal(COLLECTION_FIELD, 'entries');
+  assert.equal(ARCHIVED_FIELD, 'isArchived');
+});
+
+test('empty exports use the v2 envelope', () => {
+  assert.deepEqual(JSON.parse(serialize([])), { version: 2, entries: [] });
+});
+
+test('exports retain archived flags and default omitted or undefined flags to false', () => {
+  const rows = [
+    { id: 'a', title: 'Active' },
+    { id: 'b', title: 'Archived', archived: true },
+    { id: 'c', title: 'Explicit active', archived: false },
+    { id: 'd', title: 'Undefined', archived: undefined },
+  ];
+  assert.deepEqual(JSON.parse(serialize(rows)), {
+    version: 2,
+    entries: [
+      { id: 'a', title: 'Active', isArchived: false },
+      { id: 'b', title: 'Archived', isArchived: true },
+      { id: 'c', title: 'Explicit active', isArchived: false },
+      { id: 'd', title: 'Undefined', isArchived: false },
+    ],
+  });
+});
+
+test('exports preserve row order, Unicode, and caller-owned data', () => {
+  const rows = Object.freeze([
+    Object.freeze({ id: '二', title: 'Café 📚', archived: true, extra: 'retain locally' }),
+    Object.freeze({ id: '一', title: 'مرحبا e\u0301' }),
+  ]);
+  const before = structuredClone(rows);
+  assert.equal(
+    serialize(rows),
+    '{"version":2,"entries":[{"id":"二","title":"Café 📚","isArchived":true},{"id":"一","title":"مرحبا e\u0301","isArchived":false}]}',
+  );
+  assert.deepEqual(rows, before);
+});
