@@ -0,0 +1,46 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { CURRENT_VERSION, COLLECTION_FIELD } from './contract.mjs';
+import { serialize } from './producer.mjs';
+
+test('shared contract names the v2 wire format', () => {
+  assert.equal(CURRENT_VERSION, 2);
+  assert.equal(COLLECTION_FIELD, 'entries');
+});
+
+test('empty export has the exact v2 wire shape', () => {
+  assert.equal(serialize([]), '{"version":2,"entries":[]}');
+});
+
+test('export preserves row order, Unicode, and explicit archived values', () => {
+  const rows = [
+    { id: 'z-東京', title: 'Résumé 📄 — e\u0301', archived: true },
+    { id: 'a-α', title: 'مرحبا\n"文書"', archived: false },
+  ];
+  assert.deepEqual(JSON.parse(serialize(rows)), {
+    version: 2,
+    entries: [
+      { id: 'z-東京', title: 'Résumé 📄 — e\u0301', isArchived: true },
+      { id: 'a-α', title: 'مرحبا\n"文書"', isArchived: false },
+    ],
+  });
+});
+
+test('export defaults omitted archived without changing caller-owned data', () => {
+  const metadata = Object.freeze({ tag: 'keep' });
+  const rows = Object.freeze([
+    Object.freeze({ id: 'first', title: 'Untouched', metadata }),
+    Object.freeze({ id: 'second', title: 'Undefined', archived: undefined }),
+  ]);
+  const before = structuredClone(rows);
+  assert.deepEqual(JSON.parse(serialize(rows)), {
+    version: 2,
+    entries: [
+      { id: 'first', title: 'Untouched', isArchived: false },
+      { id: 'second', title: 'Undefined', isArchived: false },
+    ],
+  });
+  assert.deepEqual(rows, before);
+  assert.equal(rows[0].metadata, metadata);
+  assert.equal(Object.hasOwn(rows[0], 'archived'), false);
+});
